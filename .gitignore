# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Shareable single-file report copies: every screenshot packed inside,
# can pass GitHub's 100 MB file limit. Recreate with: npm run report:rebuild
Test_Execution_Report_*.html

# Local environment / secrets (never commit)
.env
.env.*
!.env.example

# Generated reports and explore output
/execution-report*/
/test_summary.html
/explore-dumps/

# Site-map crawl output: contains real MIDs / merchant names (repo is public)
/explore/scan/results/site-map-*.json

# HTML made from Markdown by npm run md (regenerate any time)
/docs/*.html
/CHANGELOG.html
/README.html
