# Copy this file to .env and fill in your own values.
# .env is ignored by git; this example file is safe to commit.

# Which environment to run: UAT-APH or UAT-Fassbayar
# (or per run:  $env:ENV_NAME='UAT-Fassbayar'; npx playwright test)
ENV_NAME=UAT-APH

# --- UAT-APH ---
UAT_APH_URL=https://10.0.1.30:35190
UAT_APH_USERNAME=
UAT_APH_PASSWORD=

# --- UAT-Fassbayar ---
UAT_FASSBAYAR_URL=https://10.0.1.30:36190
UAT_FASSBAYAR_USERNAME=
UAT_FASSBAYAR_PASSWORD=

# Optional: real mailbox for authoriser emails in the Fassbayar team's tests
# (each run uses a unique +alias of it). Empty = random @example.com address.
# NOTIFY_EMAIL=you@company.com

# Optional overrides (win over the environment block above)
# BASE_URL=https://...
# APP_USERNAME=
# APP_PASSWORD=
# IGNORE_HTTPS_ERRORS=true

# Optional: write each run's results (Status, Actual Result, Tester, Execution Date, Build) into the
# test case workbook. Path of the OneDrive-synced .xlsx (SharePoint folder synced with "Sync").
# Needs: pip install openpyxl. Not set = only the HTML report is updated.
# UAT_APH_WORKBOOK=C:\Users\<you>\<synced folder>\Baseline\APH_System_Portal_Baseline_Test_Cases_v1.0.xlsx
# UAT_FASSBAYAR_WORKBOOK=C:\Users\<you>\<synced folder>\Baseline\FassBayar_System_Portal_Baseline_Test_Cases_v1.0.xlsx
# BUILD_LABEL=UAT 20 Nov 2026

# Optional: Administrator tests that CHANGE UAT data (add users, suspend, plan code, card brand, host setting)
# ADM_ALLOW_UAT_CHANGES=true
# ADM_PREVIEW_CHANGES=true   # preview: data-changing tests run up to Review / Submit, screenshot, Back - nothing saved
# ADM_TEST_EMAIL=<team test mailbox>   # dummy bank users qaautotest01 / 02 get their emails here (ADM-009, 018)
# UAT_APH_TEST_BANK_USER_PASSWORD=       # qaautotest01 password, set once from its activation email (ADM-018)
# UAT_FASSBAYAR_TEST_BANK_USER_PASSWORD=
# ADM_TEST_BANK_USER=<disposable bank user ID>
