# Copy this file to .env (same folder) and fill in your OWN logins.
# .env is git-ignored; this example is safe to share.
# Both portals allow ONE session per user: use your own accounts.

# Which environment a run uses (or per run:  $env:ENV_NAME='UAT-FASSBAYAR')
# Environments are listed in portals.config.ts
ENV_NAME=UAT-APH

# --- UAT-APH ---
UAT_APH_URL=https://10.0.1.30:35190
UAT_APH_USERNAME=
UAT_APH_PASSWORD=

# --- UAT-FASSBAYAR ---
UAT_FASSBAYAR_URL=https://10.0.1.30:36190
UAT_FASSBAYAR_USERNAME=
UAT_FASSBAYAR_PASSWORD=

# Optional
# NOTIFY_EMAIL=me@company.com     authoriser emails go to me+<tag>@company.com
# BASE_URL=...                    overrides the environment's URL
# APP_USERNAME= / APP_PASSWORD=   override the environment's login for one run
